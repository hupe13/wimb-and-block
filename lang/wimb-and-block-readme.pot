msgid "see <a href=\"https://github.com/hupe13/wimb-and-block/blob/main/CHANGELOG.md\">Changelog</a>"
msgstr "siehe <a href=\"https://github.com/hupe13/wimb-and-block/blob/main/CHANGELOG.md\">Changelog</a>"